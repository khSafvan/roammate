{
  "name": "mojolog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mojolog/web",
    "dev:api": "npm run dev --workspace=@mojolog/api",
    "dev:all": "npm run dev:api & npm run dev",
    "build": "npm run build --workspace=@mojolog/web",
    "preview": "npm run preview --workspace=@mojolog/web",
    "test": "npm run test --workspaces --if-present",
    "deploy:web": "npm run build --workspace=@mojolog/web && wrangler pages deploy apps/web/dist --project-name=mojolog-web",
    "deploy:api": "npm run deploy --workspace=@mojolog/api",
    "secret:put": "wrangler secret put --config apps/api/wrangler.toml",
    "secret:list": "wrangler secret list --config apps/api/wrangler.toml",
    "ui-skills": "npx -y ui-skills"
  }
}
