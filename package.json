{
  "name": "mojolog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mojolog/web",
    "build": "npm run build --workspace=@mojolog/web",
    "preview": "npm run preview --workspace=@mojolog/web",
    "test": "npm run test --workspace=@mojolog/web",
    "dev:api": "npm run dev --workspace=@mojolog/api",
    "build:wasm": "cd packages/rust-core && npx wasm-pack build --target web --out-dir ../../apps/web/src/pkg"
  }
}
