{
  "name": "roammate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@roammate/web",
    "dev:api": "npm run dev --workspace=@roammate/api",
    "dev:all": "npm run dev:api & npm run dev",
    "build": "npm run build --workspace=@roammate/web",
    "preview": "npm run preview --workspace=@roammate/web",
    "test": "npm run test --workspaces --if-present",
    "deploy:web": "npm run build --workspace=@roammate/web && wrangler pages deploy apps/web/dist --project-name=mojolog-web --branch=main",
    "deploy:api": "npm run deploy --workspace=@roammate/api",
    "secret:put": "wrangler secret put --config apps/api/wrangler.toml",
    "secret:list": "wrangler secret list --config apps/api/wrangler.toml",
    "ui-skills": "npx -y ui-skills",
    "trip:create": "node scripts/agent-create-trip.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1"
  }
}
