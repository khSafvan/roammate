# ==============================================================================
# MojoLog Global Environment Configuration Sample (.env.sample)
# Copy this file to .env and adjust variables for your local or production setup.
# Never commit actual credentials or production keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Frontend Web Application (apps/web)
# ------------------------------------------------------------------------------
# Base URL pointing to the Cloudflare Worker Edge API.
# Leave blank to run purely in local-first offline vault mode (localStorage/IndexedDB).
# For local API testing with Wrangler: http://localhost:8787
# For production Cloudflare Workers: https://mojolog-api.<your-subdomain>.workers.dev
VITE_API_URL=http://localhost:8787

# Terraink 2D Vector Tile Style URL (OpenFreeMap Positron - zero API keys needed)
# Default: https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# ------------------------------------------------------------------------------
# ☁️ Backend Edge Service (apps/api - Cloudflare Workers + Turso libSQL)
# ------------------------------------------------------------------------------
# Turso Database URL for edge SQLite persistence (e.g. libsql://mojolog-db-<username>.turso.io)
TURSO_DATABASE_URL=libsql://mojolog-db-sample.turso.io

# Turso Authentication Token (generated via: turso db tokens create mojolog-db)
TURSO_AUTH_TOKEN=your_turso_auth_token_here
