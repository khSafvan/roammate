# ==============================================================================
# MojoLog - Git Ignore Configuration
# Multi-layered protection for Public GitHub Repository
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (Zero Secret Leakage)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
.dev.vars
*.dev.vars
**/.dev.vars

# Whitelist safe configuration sample templates ONLY
!.env.sample
!.env.*.sample
!**/.env.sample
!**/.env.*.sample
!.dev.vars.sample
!**/.dev.vars.sample

# Private keys, certificates, keystores, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
*.keystore
*.jks
credentials.json
service-account*.json
*.tfstate
*.tfstate.*

# ------------------------------------------------------------------------------
# 2. Dependency Directories & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
.npm/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Build Outputs, Caches & Bundlers
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.cache/
**/.cache/
.vite/
**/.vite/
.turbo/
**/.turbo/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Cloudflare Workers & Edge Artifacts
# ------------------------------------------------------------------------------
.wrangler/
**/.wrangler/
.mf/
apps/api/.wrangler/
worker/.wrangler/

# ------------------------------------------------------------------------------
# 5. Rust & WebAssembly Build Artifacts
# ------------------------------------------------------------------------------
target/
**/target/
rust-core/target/
packages/rust-core/target/
pkg/
**/pkg/
src/pkg/
apps/web/src/pkg/
**/*.rs.bk

# ------------------------------------------------------------------------------
# 6. Test Reports, Coverage & Scratch Files
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
scratch/
**/*.tmp
**/*.bak

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor directories and configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
