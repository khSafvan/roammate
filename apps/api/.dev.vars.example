# Turso (libSQL) Edge Database
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT Signing Secret (required for Bearer token generation & verification)
JWT_SECRET=your-random-jwt-secret-string-change-this-in-production

# Allowed Origins for CORS (comma-separated list, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,https://mojolog-web.pages.dev
