# ==============================================================================
# MojoLog Frontend Web App Environment Sample (.env.sample)
# Copy to .env for local configuration
# ==============================================================================

# Base URL pointing to the Cloudflare Worker Edge API
# Leave blank to use offline-first local vault (localStorage)
VITE_API_URL=http://localhost:8787

# Terraink 2D Vector Tile Style URL (OpenFreeMap Positron)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Real-world Multi-modal Routing Engine Base URL
VITE_OSRM_ROUTER_URL=https://router.project-osrm.org
